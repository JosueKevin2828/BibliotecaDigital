<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.bibliotecadigital.controller.LibrosController"
            style="-fx-background-color: #F5F0E6;">

    <top>
        <VBox spacing="10" style="-fx-background-color: #5D4037; -fx-padding: 15;">
            <Label text="Gestion de Libros"
                   style="-fx-text-fill: #FFE0B2; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Button text="← Volver al Dashboard" onAction="#handleVolver"
                    style="-fx-background-color: #8D6E63; -fx-text-fill: white;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <HBox spacing="10">
                <TextField fx:id="txtTitulo" promptText="Titulo" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #D7CCC8; -fx-border-radius: 5;"/>
                <TextField fx:id="txtAutor" promptText="Autor" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #D7CCC8; -fx-border-radius: 5;"/>
                <TextField fx:id="txtCategoria" promptText="Categoria" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #D7CCC8; -fx-border-radius: 5;"/>
            </HBox>

            <HBox spacing="10">
                <TextField fx:id="txtIsbn" promptText="ISBN" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #D7CCC8; -fx-border-radius: 5;"/>
                <TextField fx:id="txtCantidad" promptText="Cantidad" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #D7CCC8; -fx-border-radius: 5;"/>
                <Button text="Agregar" onAction="#handleAgregar"
                        style="-fx-background-color: #8D6E63; -fx-text-fill: white; -fx-border-radius: 5;"/>
                <Button text="Actualizar" onAction="#handleActualizar"
                        style="-fx-background-color: #795548; -fx-text-fill: white; -fx-border-radius: 5;"/>
                <Button text="Eliminar" onAction="#handleEliminar"
                        style="-fx-background-color: #A1887F; -fx-text-fill: white; -fx-border-radius: 5;"/>
            </HBox>

            <HBox spacing="10">
                <TextField fx:id="txtBuscar" promptText="Buscar por titulo..." HBox.hgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #D7CCC8; -fx-border-radius: 5;"/>
                <Button text="Buscar" onAction="#handleBuscar"
                        style="-fx-background-color: #6D4C41; -fx-text-fill: white; -fx-border-radius: 5;"/>
                <Button text="Mostrar Todos" onAction="#handleMostrarTodos"
                        style="-fx-background-color: #5D4037; -fx-text-fill: white; -fx-border-radius: 5;"/>
                <Button text="Exportar CSV" onAction="#handleExportarCSV"
                        style="-fx-background-color: #8D6E63; -fx-text-fill: white; -fx-border-radius: 5;"/>
                <Button text="Exportar JSON" onAction="#handleExportarJSON"
                        style="-fx-background-color: #8D6E63; -fx-text-fill: white; -fx-border-radius: 5;"/>
            </HBox>

            <TableView fx:id="tablaLibros" prefHeight="400" style="-fx-background-color: #EFEBE9;">
                <columns>
                    <TableColumn text="ID" fx:id="colId" prefWidth="50"/>
                    <TableColumn text="Titulo" fx:id="colTitulo" prefWidth="200"/>
                    <TableColumn text="Autor" fx:id="colAutor" prefWidth="150"/>
                    <TableColumn text="Categoria" fx:id="colCategoria" prefWidth="100"/>
                    <TableColumn text="ISBN" fx:id="colIsbn" prefWidth="120"/>
                    <TableColumn text="Disponible" fx:id="colCantidad" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>