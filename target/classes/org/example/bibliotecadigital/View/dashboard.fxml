<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.bibliotecadigital.controller.DashboardController"
            style="-fx-background-color: #F5F0E6;">

    <top>
        <VBox spacing="5" style="-fx-background-color: #5D4037; -fx-padding: 10;">
            <Label fx:id="lblUsuario" text="Bienvenido, Usuario"
                   style="-fx-text-fill: #FFE0B2; -fx-font-size: 14px;"/>
            <Label text="Sistema de Gestion de Biblioteca Digital"
                   style="-fx-text-fill: #D7CCC8; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <left>
        <VBox spacing="10" style="-fx-background-color: #6D4C41; -fx-padding: 15; -fx-pref-width: 200;">
            <Button text="Dashboard" onAction="#handleDashboard" maxWidth="Infinity"
                    style="-fx-background-color: #8D6E63; -fx-text-fill: white; -fx-padding: 10;"/>

            <Button text="Libros" onAction="#handleLibros" maxWidth="Infinity"
                    style="-fx-background-color: #5D4037; -fx-text-fill: #FFE0B2; -fx-padding: 10;"/>

            <Button text="Usuarios" onAction="#handleUsuarios" maxWidth="Infinity"
                    style="-fx-background-color: #5D4037; -fx-text-fill: #FFE0B2; -fx-padding: 10;"/>

            <Button text="Prestamos" onAction="#handlePrestamos" maxWidth="Infinity"
                    style="-fx-background-color: #5D4037; -fx-text-fill: #FFE0B2; -fx-padding: 10;"/>

            <Separator/>

            <Button text="Cerrar Sesion" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: #A1887F; -fx-text-fill: white; -fx-padding: 10;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 30;">
            <Label text="Panel de Control" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5D4037;"/>

            <Label text="Estadisticas del Sistema" style="-fx-font-size: 16px; -fx-text-fill: #6D4C41;"/>

            <HBox spacing="30" alignment="CENTER">
                <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #8D6E63; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10;">
                    <Label text="Libros" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                    <Label fx:id="lblTotalLibros" text="0" style="-fx-text-fill: #FFE0B2; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #795548; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10;">
                    <Label text="Usuarios" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                    <Label fx:id="lblTotalUsuarios" text="0" style="-fx-text-fill: #FFE0B2; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #5D4037; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10;">
                    <Label text="Prestamos Activos" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                    <Label fx:id="lblPrestamosActivos" text="0" style="-fx-text-fill: #FFE0B2; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>