<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.bibliotecadigital.controller.ReportesController"
            style="-fx-background-color: #ecf0f1;">

    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="Generacion de Reportes"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Button text="← Volver al Dashboard" onAction="#handleVolver"
                    style="-fx-background-color: #7f8c8d; -fx-text-fill: white;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 50;">
            <Label text="Seleccione el tipo de reporte" style="-fx-font-size: 16px;"/>

            <Button text="Reporte de Libros Prestados" onAction="#handleReporteLibrosPrestados"
                    maxWidth="300" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10;"/>

            <Button text="Reporte de Usuarios Morosos" onAction="#handleReporteUsuariosMorosos"
                    maxWidth="300" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10;"/>

            <Button text="Reporte de Inventario" onAction="#handleReporteInventario"
                    maxWidth="300" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 10;"/>

            <Label fx:id="lblEstado" text="Listo para generar reportes" style="-fx-text-fill: #7f8c8d; -fx-padding: 20;"/>
        </VBox>
    </center>
</BorderPane>